{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AutoPost Pro Beta release update manifest",
  "type": "object",
  "required": ["schema_version", "channel", "published"],
  "properties": {
    "schema_version": {"const": 1},
    "channel": {"const": "beta"},
    "published": {"type": "boolean"},
    "message": {"type": "string", "maxLength": 300},
    "version": {"type": "string", "pattern": "^0\\.[0-9]+\\.[0-9]+-beta\\.[1-9][0-9]*$"},
    "download_url": {"type": "string", "format": "uri"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "notes": {"type": "string", "maxLength": 2000}
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"properties": {"published": {"const": true}}},
      "then": {"required": ["version", "download_url", "sha256"]}
    }
  ]
}
